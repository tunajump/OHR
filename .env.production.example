# Production Environment Variables
NODE_ENV=production
PORT=5000

# Database Configuration (Supabase PostgreSQL / Cloud DB)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Single Master Mailbox Configuration
SYSTEM_FROM_EMAIL=admin@ohreferral.co.uk
SYSTEM_SENDER_NAME=OHReferral
ADMIN_EMAIL=admin@ohreferral.co.uk
CONTACT_DEFAULT_RECEIVER=admin@ohreferral.co.uk

# SMTP Email Configuration (Optional - for sending live external emails)
# If left empty, system records dispatched emails to structured audit logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=admin@ohreferral.co.uk
SMTP_PASS=
SMTP_SECURE=false

# Legacy MySQL Configuration (Optional Fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_a_strong_database_password_123!
DB_NAME=ohr_production

# JWT Security
JWT_SECRET=replace_with_a_64_character_random_hex_string_key_2026

# Frontend API URL
REACT_APP_API_URL=/api
