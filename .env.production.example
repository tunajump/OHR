# Production Environment Variables
NODE_ENV=production
PORT=5000

# Database Configuration (Supabase PostgreSQL / Cloud DB)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Legacy MySQL Configuration (Optional Fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_a_strong_database_password_123!
DB_NAME=ohr_production

# JWT Security
JWT_SECRET=replace_with_a_64_character_random_hex_string_key_2026

# Frontend API URL
REACT_APP_API_URL=/api
